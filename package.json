{
  "name": "field-service-sdk",
  "version": "3.0.14",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "TypeScript SDK for the Field Service application",
  "keywords": [
    "field-service",
    "sdk",
    "typescript",
    "graphql"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/discobeta/field-service-sdk.git"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "update-schema": "node src/update-schema.js",
    "generate": "graphql-codegen --config codegen.yml",
    "prepare": "npm run update-schema && npm run generate && npm run build",
    "prepublishOnly": "npm run prepare",
    "publish": "npm publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "graphql": "^16.11.0",
    "react": "19.1.0"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/graceful-fs": "^4.1.9",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/stack-utils": "^2.0.3",
    "@types/yargs": "^17.0.33",
    "@types/yargs-parser": "^21.0.3",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ]
}
